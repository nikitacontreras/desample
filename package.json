{
  "name": "desample",
  "version": "1.0.0",
  "description": "Serato Sample project parser and .serato-stems extractor",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "demo": "tsx demo/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.2",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.4",
    "tsup": "^8.0.2",
    "tsx": "^4.19.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.61.0",
    "vitest": "^1.6.0"
  },
  "license": "MIT",
  "author": "nikitacontreras",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nikitacontreras/desample.git"
  },
  "homepage": "https://github.com/nikitacontreras/desample#readme",
  "bugs": {
    "url": "https://github.com/nikitacontreras/desample/issues"
  },
  "keywords": [
    "serato",
    "sample",
    "dj",
    "music",
    "stems",
    "parser",
    "serato-sample"
  ]
}
